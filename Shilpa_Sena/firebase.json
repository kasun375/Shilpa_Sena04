          "projectId": "exim-graphics-lms",
          "configurations": {
            "android": "1:54375527170:android:fe0a88d846e7889d0c881b",
            "ios": "1:54375527170:ios:3e19b2ea767be68f0c881b",
            "macos": "1:54375527170:ios:e7786be1814861e00c881b",
            "web": "1:54375527170:web:80b8dff8c3a1e01c0c881b",
