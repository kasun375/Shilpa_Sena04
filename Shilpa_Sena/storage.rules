rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'admin@eximgraphics.com' ||
        request.auth.token.email.lower() == 'shilpasenaadmin@gmail.com'
      );
    }

    // User Profile Pictures
    match /user_profiles/{userId} {
      allow read: if true; // Publicly readable for profile display
      allow write: if request.auth != null && (
        userId == request.auth.uid || 
        userId == request.auth.uid + '.jpg' || 
        userId.matches('.*' + request.auth.uid + '.*')
      );
      allow delete: if request.auth != null && (
        userId == request.auth.uid || 
        userId == request.auth.uid + '.jpg' || 
        userId.matches('.*' + request.auth.uid + '.*')
      );
    }

    // Promotional Banners
    match /promos/{fileName} {
      allow read: if true; // Publicly readable for the home screen
      allow write, delete: if isAdmin();
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
