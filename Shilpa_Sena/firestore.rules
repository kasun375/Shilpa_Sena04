rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read for courses and promos so guests can see them on the home screen
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /promos/{promoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default rule for all other collections: authenticated users only
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
